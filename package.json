{
  "name": "chu-djibouti-his",
  "private": true,
  "version": "0.0.0",
  "description": "Plateforme hospitali\u00e8re du CHU de Djibouti (socle Bahmni + couche d'int\u00e9gration et portail)",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm --filter @chu/portal typecheck",
    "test": "node tools/test-runner/src/cli.ts",
    "check:repo": "node tools/repo-check/src/cli.ts",
    "seed": "node tools/seed/src/cli.ts",
    "check": "pnpm run check:repo && pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
