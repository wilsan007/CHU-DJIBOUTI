# Point d'entrée de production : HTTPS seulement, portail statique, API et Keycloak derrière.
# Modèle rendu par l'image nginx (envsubst) : SERVER_NAME, API_UPSTREAM, IDP_UPSTREAM, CSP_CONNECT.
# Le certificat est fourni par le CHU (autorité interne ou Let's Encrypt) dans /etc/nginx/tls/{fullchain,privkey}.pem.
server_tokens off;
upstream api { server ${API_UPSTREAM}; }
upstream idp { server ${IDP_UPSTREAM}; }
# Freinage des tentatives de connexion seulement (formulaire et échange de jeton) : une clé vide n'est pas limitée,
# donc le chargement des feuilles de style et polices de la page de connexion n'est jamais compté.
map $request_uri $login_key {
  default "";
  ~^/auth/realms/[^/]+/login-actions/authenticate $binary_remote_addr;
  ~^/auth/realms/[^/]+/protocol/openid-connect/token $binary_remote_addr;
}
limit_req_zone $login_key zone=login:10m rate=30r/m;
limit_req_zone $binary_remote_addr zone=general:10m rate=20r/s;
# Codes de connexion du portail patient : peu de demandes par adresse (chaque code coûte un SMS).
limit_req_zone $binary_remote_addr zone=otp:10m rate=10r/m;

server {
  listen 80;
  server_name ${SERVER_NAME};
  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl;
  http2 on;
  server_name ${SERVER_NAME};
  ssl_certificate /etc/nginx/tls/fullchain.pem;
  ssl_certificate_key /etc/nginx/tls/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;
  ssl_session_timeout 1d;
  ssl_session_cache shared:SSL:10m;
  ssl_session_tickets off;

  add_header Strict-Transport-Security "max-age=31536000" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header Referrer-Policy "no-referrer" always;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
  add_header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src ${CSP_CONNECT}; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" always;

  limit_req zone=general burst=40 nodelay;

  # Les métriques ne sortent jamais par le point d'entrée public.
  location = /metrics { return 404; }

  location /api/portal/otp/ {
    limit_req zone=otp burst=5 nodelay;
    proxy_pass http://api;
    proxy_set_header X-Request-Id $request_id;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;
    client_max_body_size 4k;
  }

  location /api/ {
    proxy_pass http://api;
    proxy_set_header X-Request-Id $request_id;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;
    # Images d'imagerie envoyées en base64 : 16 Mo côté API.
    client_max_body_size 17m;
    proxy_read_timeout 60s;
  }
  location = /health { proxy_pass http://api; }

  location /auth/ {
    limit_req zone=login burst=15 nodelay;
    # Keycloak envoie lui-même sa politique CSP et ses règles de cadre (ses pages ont des scripts en ligne) ; on ne
    # répète donc ici que les en-têtes qui ne gênent pas. Un add_header dans un bloc location remplace ceux du serveur.
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    # Keycloak est lancé avec --http-relative-path=/auth : le préfixe est conservé.
    proxy_pass http://idp;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_buffer_size 16k;
    proxy_buffers 8 16k;
  }

  # Portail : fichiers statiques ; le point d'entrée n'est jamais mis en cache, les fichiers à empreinte oui.
  root /usr/share/nginx/html;
  # (pas d'add_header ici : il masquerait les en-têtes de sécurité du serveur)
  location /assets/ { expires max; try_files $uri =404; }
  location / { expires -1; try_files $uri /index.html; }
}
