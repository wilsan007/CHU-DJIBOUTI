{
  "realm": "chu",
  "enabled": true,
  "displayName": "CHU de Djibouti",
  "internationalizationEnabled": true,
  "supportedLocales": ["fr", "ar"],
  "defaultLocale": "fr",
  "sslRequired": "external",
  "registrationAllowed": false,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 1800,
  "roles": {
    "realm": [
      {
        "name": "reception",
        "description": "Rôle reception (voir services/api/src/auth/permissions.ts)"
      },
      {
        "name": "cashier",
        "description": "Rôle cashier (voir services/api/src/auth/permissions.ts)"
      },
      {
        "name": "doctor",
        "description": "Rôle doctor (voir services/api/src/auth/permissions.ts)"
      },
      {
        "name": "nurse",
        "description": "Rôle nurse (voir services/api/src/auth/permissions.ts)"
      },
      {
        "name": "lab",
        "description": "Rôle lab (voir services/api/src/auth/permissions.ts)"
      },
      {
        "name": "biologist",
        "description": "Rôle biologist (voir services/api/src/auth/permissions.ts)"
      },
      {
        "name": "imaging",
        "description": "Rôle imaging (voir services/api/src/auth/permissions.ts)"
      },
      {
        "name": "pharmacy",
        "description": "Rôle pharmacy (voir services/api/src/auth/permissions.ts)"
      },
      {
        "name": "direction",
        "description": "Rôle direction (voir services/api/src/auth/permissions.ts)"
      },
      {
        "name": "admin",
        "description": "Rôle admin (voir services/api/src/auth/permissions.ts)"
      },
      {
        "name": "storekeeper",
        "description": "Rôle storekeeper (voir services/api/src/auth/permissions.ts)"
      },
      {
        "name": "hr",
        "description": "Rôle hr (voir services/api/src/auth/permissions.ts)"
      }
    ]
  },
  "clients": [
    {
      "clientId": "chu-web",
      "name": "Application web CHU",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": ["http://localhost:8080/*"],
      "webOrigins": ["http://localhost:8080"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "chu-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "chu-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ],
      "fullScopeAllowed": false
    },
    {
      "clientId": "chu-dev-cli",
      "name": "DEV UNIQUEMENT : tests automatiques (mot de passe direct)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "chu-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "chu-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ],
      "fullScopeAllowed": false
    },
    {
      "clientId": "chu-admin-api",
      "name": "Gestion des comptes par l'API (compte de service)",
      "enabled": true,
      "publicClient": false,
      "secret": "${CHU_ADMIN_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect",
      "fullScopeAllowed": false
    }
  ],
  "users": [
    {
