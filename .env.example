# Noms des variables d'environnement (étape 3.5 du plan). AUCUNE valeur ici.
# Copier ce fichier en `.env` (ignoré par Git) et renseigner les valeurs en local.
# En production, les secrets viennent d'un coffre ou de l'environnement du serveur.
# Les variables des phases suivantes sont ajoutées au fur et à mesure (phase 1 : socle).

# --- Général ---
CHU_ENV=                      # dev | staging | prod
CHU_DOMAIN=                   # nom interne de base, défini avec la DSI
TZ=                           # fuseau horaire des conteneurs

# --- Connexion unique (Keycloak) ---
KEYCLOAK_ADMIN=
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_REALM=               # chu

# --- Bus d'événements (RabbitMQ) ---
RABBITMQ_DEFAULT_USER=
RABBITMQ_DEFAULT_PASS=

# --- Passerelle d'intégration (OpenHIM) ---
OPENHIM_ROOT_PASSWORD=

# --- Bases de données : une paire par application, jamais partagée ---
OPENMRS_DB_PASSWORD=
OPENELIS_DB_PASSWORD=
ODOO_DB_PASSWORD=
INTEGRATION_DB_PASSWORD=

# --- Notifications (SMS / WhatsApp) : fournisseur à choisir par ticket de décision ---
SMS_PROVIDER_API_KEY=

# --- Sauvegardes chiffrées ---
BACKUP_REPOSITORY=
BACKUP_PASSWORD=

# --- Gestion des comptes par l'API (compte de service Keycloak `chu-admin-api`) ---
CHU_ADMIN_CLIENT_SECRET=      # lu par l'import du domaine et par l'API (KEYCLOAK_ADMIN_CLIENT_SECRET)
CHU_LAB_BRIDGE_SECRET=      # secret du compte de service du pont d'automates (import du domaine + BRIDGE_CLIENT_SECRET)
